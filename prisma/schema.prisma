generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled host (-pooler), used at runtime
  directUrl = env("DIRECT_URL")   // Neon direct host, used by `prisma migrate` only
}

// ================================================================ identity ==

enum Role {
  ADMIN
  MENTOR
  PARTICIPANT
}

enum Locale {
  fr
  en
}

enum UserStatus {
  INVITED  // row exists, no password yet: can only consume an INVITE token
  ACTIVE
  DISABLED // cannot log in; sessions are deleted on transition
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  phone        String?
  role         Role
  status       UserStatus @default(INVITED)
  locale       Locale     @default(fr)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions            Session[]
  authTokens          AuthToken[]
  application         Application?        @relation("ApplicationParticipant")
  enrollments         Enrollment[]
  mentoredEnrollments Enrollment[]        @relation("EnrollmentMentor")
  applicationReviews  ApplicationReview[]
  decidedApplications Application[]       @relation("ApplicationDecider")
  validatedProgress   CourseProgress[]    @relation("ProgressValidator")
  evaluationsGiven    Evaluation[]        @relation("EvaluationEvaluator")
  notesWritten        MentorNote[]        @relation("NoteAuthor")
  activityAsActor     ActivityLog[]       @relation("ActivityActor")

  @@index([role, status])
  @@map("users")
}

/// Opaque 32-byte token in the cookie; only its sha256 is stored.
model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuthTokenPurpose {
  INVITE
  PASSWORD_RESET
}

/// One table for invitation and reset links: identical shape, identical lifecycle.
model AuthToken {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at")
  consumedAt DateTime?        @map("consumed_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// ============================================================== admissions ==

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  WAITLISTED
  REJECTED
  WITHDRAWN
}

enum DegreeLevel {
  BAC_PLUS_2 // BTS / DUT
  LICENCE
  MASTER
  DOCTORAT
  AUTRE
}

enum DeviceAccess {
  NONE
  SMARTPHONE_ONLY
  SHARED_COMPUTER
  OWN_COMPUTER
}

enum InternetAccess {
  OCCASIONAL  // cybercafé, borrowed data
  MOBILE_DATA // own phone data, limited
  RELIABLE    // home / office broadband
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

enum PathwayType {
  SHORT
  MEDIUM
  LONG
}

model Application {
  id                String            @id @default(uuid())
  status            ApplicationStatus @default(SUBMITTED)
  locale            Locale            @default(fr) // which form the applicant used
  // identity & contact
  firstName         String            @map("first_name")
  lastName          String            @map("last_name")
  email             String
  phone             String
  city              String
  // background
  degreeLevel       DegreeLevel       @map("degree_level")
  fieldOfStudy      String            @map("field_of_study")
  institution       String
  graduationYear    Int               @map("graduation_year")
  // fit (the three screening axes: motivation, access, feedback)
  motivation        String
  deviceAccess      DeviceAccess      @map("device_access")
  internetAccess    InternetAccess    @map("internet_access")
  hoursPerWeek      Int               @map("hours_per_week")
  pathwayPreference PathwayType?      @map("pathway_preference")
  feedbackWilling   Boolean           @map("feedback_willing")
  frenchLevel       LanguageLevel     @map("french_level")
  englishLevel      LanguageLevel     @map("english_level")
  howHeard          String?           @map("how_heard")
  consentAt         DateTime          @map("consent_at")
  // decision (ADMIN)
  decidedById       String?           @map("decided_by_id")
  decidedAt         DateTime?         @map("decided_at")
  decisionNotes     String?           @map("decision_notes")
  /// The PARTICIPANT account created on admission. Unique: one account per application.
  userId            String?           @unique @map("user_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  decidedBy User?               @relation("ApplicationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  user      User?               @relation("ApplicationParticipant", fields: [userId], references: [id], onDelete: SetNull)
  reviews   ApplicationReview[]
  activity  ActivityLog[]

  // email deliberately NOT unique: a rejected applicant may reapply for a later cohort
  @@index([status, createdAt])
  @@index([email])
  @@map("applications")
}

/// One score card per screener per application; the decision lives on Application.
model ApplicationReview {
  id              String   @id @default(uuid())
  applicationId   String   @map("application_id")
  reviewerId      String   @map("reviewer_id")
  motivationScore Int      @map("motivation_score") // 1–5
  accessScore     Int      @map("access_score")     // 1–5
  feedbackScore   Int      @map("feedback_score")   // 1–5
  comment         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([applicationId, reviewerId])
  @@map("application_reviews")
}

// ============================================================== curriculum ==

model Competency {
  id            String   @id @default(uuid())
  slug          String   @unique
  nameFr        String   @map("name_fr")
  nameEn        String   @map("name_en")
  descriptionFr String?  @map("description_fr")
  descriptionEn String?  @map("description_en")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  courses      CompetencyCourse[]
  pathwayItems PathwayTemplateItem[]
  progress     CourseProgress[]
  evaluations  Evaluation[]

  @@map("competencies")
}

/// An EXTERNAL course. `provider` is free text on purpose (the employer survey
/// will reshape the catalogue); the UI offers a suggestion list.
model CourseResource {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  provider          String
  url               String
  language          Locale
  estimatedHours    Int      @map("estimated_hours")
  isFree            Boolean  @default(true) @map("is_free")
  hasCertificate    Boolean  @default(false) @map("has_certificate")
  certificateIsFree Boolean  @default(false) @map("certificate_is_free")
  description       String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  competencies CompetencyCourse[]
  pathwayItems PathwayTemplateItem[]
  progress     CourseProgress[]

  @@index([provider])
  @@map("course_resources")
}

model CompetencyCourse {
  competencyId String @map("competency_id")
  courseId     String @map("course_id")
  sortOrder    Int    @default(0) @map("sort_order")

  competency Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  course     CourseResource @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([competencyId, courseId])
  @@map("competency_courses")
}

model PathwayTemplate {
  id            String      @id @default(uuid())
  slug          String      @unique
  name          String
  type          PathwayType
  targetWeeks   Int         @map("target_weeks")
  descriptionFr String?     @map("description_fr")
  isDefault     Boolean     @default(false) @map("is_default") // pre-selected for a new cohort of this type
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items   PathwayTemplateItem[]
  cohorts Cohort[]

  @@index([type, isActive])
  @@map("pathway_templates")
}

/// A (competency, course) pair: the same course may serve one competency in
/// one template and another elsewhere.
model PathwayTemplateItem {
  id           String  @id @default(uuid())
  templateId   String  @map("template_id")
  competencyId String  @map("competency_id")
  courseId     String  @map("course_id")
  sortOrder    Int     @default(0) @map("sort_order")
  isRequired   Boolean @default(true) @map("is_required")

  template   PathwayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  competency Competency      @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  course     CourseResource  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([templateId, courseId])
  @@index([templateId, sortOrder])
  @@map("pathway_template_items")
}

// ================================================================= cohorts ==

enum CohortStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Cohort {
  id                String       @id @default(uuid())
  slug              String       @unique
  name              String
  pathwayType       PathwayType  @map("pathway_type")
  pathwayTemplateId String       @map("pathway_template_id")
  startDate         DateTime     @map("start_date") @db.Date
  endDate           DateTime     @map("end_date") @db.Date
  status            CohortStatus @default(PLANNED)
  description       String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  pathwayTemplate PathwayTemplate @relation(fields: [pathwayTemplateId], references: [id], onDelete: Restrict)
  enrollments     Enrollment[]

  @@index([status, startDate])
  @@map("cohorts")
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DROPPED
}

model Enrollment {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  cohortId       String           @map("cohort_id")
  mentorId       String?          @map("mentor_id")
  status         EnrollmentStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  completedAt    DateTime?        @map("completed_at")
  /// Bumped on every participant write (progress, proof) and on login.
  /// The "inactive > 14 days" flag is computed from it at read time — no cron.
  lastActivityAt DateTime?        @map("last_activity_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort      Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  mentor      User?            @relation("EnrollmentMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  progress    CourseProgress[]
  evaluations Evaluation[]
  notes       MentorNote[]
  activity    ActivityLog[]

  @@unique([userId, cohortId])
  @@index([cohortId, status])
  @@index([mentorId])
  @@map("enrollments")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProofType {
  NONE
  LINK
  FILE // later (R2); proofFileKey holds the object key
}

enum ValidationStatus {
  NONE
  PENDING
  VALIDATED
  REJECTED
}

/// Materialised from the cohort's template at admission, so editing a template
/// never rewrites a running cohort. One row per (enrollment, course).
model CourseProgress {
  id               String           @id @default(uuid())
  enrollmentId     String           @map("enrollment_id")
  courseId         String           @map("course_id")
  competencyId     String           @map("competency_id") // copied from the template item
  isRequired       Boolean          @default(true) @map("is_required")
  sortOrder        Int              @default(0) @map("sort_order")
  status           ProgressStatus   @default(NOT_STARTED)
  startedAt        DateTime?        @map("started_at")
  completedAt      DateTime?        @map("completed_at")
  proofType        ProofType        @default(NONE) @map("proof_type")
  proofUrl         String?          @map("proof_url")
  proofFileKey     String?          @map("proof_file_key")
  proofSubmittedAt DateTime?        @map("proof_submitted_at")
  validationStatus ValidationStatus @default(NONE) @map("validation_status")
  validatedById    String?          @map("validated_by_id")
  validatedAt      DateTime?        @map("validated_at")
  validationNote   String?          @map("validation_note")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  enrollment  Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course      CourseResource @relation(fields: [courseId], references: [id], onDelete: Restrict)
  competency  Competency     @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  validatedBy User?          @relation("ProgressValidator", fields: [validatedById], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, courseId])
  @@index([validationStatus, proofSubmittedAt]) // the "proofs pending" queue
  @@map("course_progress")
}

// ============================================================= evaluations ==

/// Several evaluations per competency are allowed (re-evaluation); the latest
/// by evaluatedAt is "the" result.
model Evaluation {
  id           String   @id @default(uuid())
  enrollmentId String   @map("enrollment_id")
  competencyId String   @map("competency_id")
  evaluatorId  String   @map("evaluator_id")
  score        Int      // 1–5, validated in zod
  rubric       Json?    // per-criterion detail, shape decided later
  notes        String?
  evaluatedAt  DateTime @default(now()) @map("evaluated_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  evaluator  User       @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@index([enrollmentId, competencyId, evaluatedAt])
  @@map("evaluations")
}

// ======================================================= notes & activity ==

model MentorNote {
  id                   String   @id @default(uuid())
  enrollmentId         String   @map("enrollment_id")
  authorId             String   @map("author_id")
  body                 String
  visibleToParticipant Boolean  @default(false) @map("visible_to_participant")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  author     User       @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([enrollmentId, createdAt])
  @@map("mentor_notes")
}

enum ActivityType {
  APPLICATION_SUBMITTED
  APPLICATION_REVIEWED
  APPLICATION_DECIDED
  PARTICIPANT_ADMITTED
  INVITE_SENT
  INVITE_ACCEPTED
  PASSWORD_RESET_REQUESTED
  LOGIN
  MENTOR_ASSIGNED
  ENROLLMENT_STATUS_CHANGED
  PROGRESS_UPDATED
  PROOF_SUBMITTED
  PROOF_VALIDATED
  PROOF_REJECTED
  EVALUATION_CREATED
  NOTE_ADDED
  EMAIL_SENT
  EMAIL_FAILED
}

/// Append-only. Feeds the participant timeline and "last activity"; also the
/// audit trail for emails (a provider can accept a message and still drop it).
model ActivityLog {
  id            String       @id @default(uuid())
  type          ActivityType
  actorId       String?      @map("actor_id") // null = system or anonymous applicant
  enrollmentId  String?      @map("enrollment_id")
  applicationId String?      @map("application_id")
  subjectUserId String?      @map("subject_user_id")
  payload       Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  actor       User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  enrollment  Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, createdAt])
  @@index([applicationId, createdAt])
  @@index([type, createdAt])
  @@map("activity_log")
}
